# Copy to backend/.env and fill real values. backend/.env is git-ignored - never commit it.
# These are placeholders only; do not put real credentials in this file.

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Set true only when running behind a reverse proxy (needed for correct client IPs).
TRUST_PROXY=false

# ---- Session signing ------------------------------------------------------
# REQUIRED in production. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development a temporary secret is generated automatically if this is left blank.
SESSION_SECRET=
SESSION_TTL_HOURS=12
REMEMBER_TTL_DAYS=30
# Optional idle timeout in minutes (0 disables it).
SESSION_IDLE_TTL_MINUTES=0
# Cookies are marked Secure automatically when NODE_ENV=production.
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# ---- Data store -----------------------------------------------------------
# auto (default): MongoDB when credentials below exist, otherwise local JSON file store.
# Force with file | mongo. Use "file" for offline development and demos.
DATA_STORE=
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB_NAME=ga6
# Only needed when the mongodb+srv DNS TXT lookup fails on your network.
MONGODB_HOSTS=
MONGODB_REPLICA_SET=

# ---- First super admin (npm run seed  |  npm run bootstrap:owner) -----------
# bootstrap:owner reads the password from this key or from --password-file=<path>; the secret is
# never an argument value, so it cannot leak into shell history. If both are set, the named file
# wins and this key is ignored. Leave it empty to have a strong random password generated and
# printed once (bootstrap:owner --generate). Do not reuse a real password here; backend/.env is
# git-ignored, but keep it out of any screenshot or log.
ADMIN_BOOTSTRAP_EMAIL=admin@ecu.edu.eg
ADMIN_BOOTSTRAP_NAME=Portal Administrator
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Policy ---------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=ecu.edu.eg
ENFORCE_EMAIL_DOMAIN=true
MIN_PASSWORD_LENGTH=8
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# ---- Roles and dashboard --------------------------------------------------
# The primary owner account. Its password reset, disable, role change, group move
# and delete are refused for every caller through the admin API, and the accounts
# screen shows no Password/Disable/Delete buttons for it. Only self-service password
# change (needs the current password) stays available.
PROTECTED_OWNER_EMAIL=192600250@ecu.edu.eg
# "Online now" on the dashboard = an account with a session seen in the last N minutes.
# Session activity is recorded at most once a minute.
ONLINE_WINDOW_MINUTES=15

# ---- Email (Resend or Outlook) ---------------------------------------------
# MAIL_PROVIDER picks the transport: resend (default) or outlook.
MAIL_PROVIDER=resend
# Resend - create an API key in your Resend dashboard. MAIL_FROM must be a sender
# address on a domain you have verified with Resend.
RESEND_API_KEY=
MAIL_FROM=
# Outlook / Microsoft 365 over the Graph API. Create an app registration with the
# Mail.Send *application* permission and grant admin consent, then fill these in.
# OUTLOOK_SENDER is the mailbox that sends, e.g. portal@ecu.edu.eg
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_SENDER=
# Destination for saved problem report notifications.
MAIL_REPORT_TO=
# The one-time sign-up code is six digits and lives this long (2-30 minutes).
EMAIL_CODE_TTL_MINUTES=10

# ---- Documents / uploads (backend/src/services/documents.js) ----------------
# Where uploaded files live. Keep this OUTSIDE the served frontend folder.
# On ephemeral hosts (Render/Fly free tiers) this directory disappears between
# restarts: point UPLOAD_DIR at a persistent volume, or serve documents from an
# object-storage service instead - this project writes to the filesystem only.
UPLOAD_DIR=
# Decoded file size limit in MB (1-100). The JSON request body allows for base64.
UPLOAD_MAX_MB=10
