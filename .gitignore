# Dependencies
node_modules/

# Secrets / environment variables
.env
backend/.env
backend/atlas-credentials.env

# Logs
*.log
npm-debug.log*

# Local JSON data store (DATA_STORE=file) - never commit real accounts
backend/data_base/
data_base/

# Uploaded documents - private binaries, served only through the authorization-checked API.
# `storage/*` (not `storage/`) so the .gitkeep placeholder can stay tracked.
backend/storage/*
!backend/storage/.gitkeep

# Editor / OS
.vscode/
.DS_Store

# Frontend build output (regenerated by `npm run build` inside frontend/)
frontend/dist/
frontend/node_modules/
# Screenshots and the run log from `npm run verify:browser` are build output.
# The account fixture is regenerated on every run and must never be committed.
tools/browser-smoke/
tools/auth-smoke/

# Backend build/typecheck output
backend/test-conn.log
